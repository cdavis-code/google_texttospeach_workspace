# Copy to .env and fill in. A TTS API key should be RESTRICTED in the Cloud
# Console to the Text-to-Speech API only — an unrestricted key can be abused
# for every API enabled in your project.
GOOGLE_TTS_API_KEY=your-api-key

# Optional: override the default OAuth credential file locations.
# GOOGLE_TTS_CLIENT_SECRETS_FILE=client_secret.json
# GOOGLE_TTS_ACCESS_TOKENS_FILE=tts_access_tokens.json

# Set to 1 to disable reading credentials paths from this .env file.
# GOOGLE_TTS_DISABLE_DOTENV=1
